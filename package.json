{
  "name": "@stellarpos/surface",
  "version": "0.2.0",
  "private": true,
  "description": "StellarPOS point-of-sale web app: register, inventory, orders, customers, reports and Stellar QR checkout",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:contract": "vitest run src/tests/contracts",
    "type-check": "tsc -b --noEmit",
    "check": "npm run lint && npm run type-check && npm test",
    "audit": "npm audit --audit-level=high",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "prepare": "husky install"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.75.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.508.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^6.30.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pact-foundation/pact": "^17.1.4",
    "@playwright/test": "^1.40.1",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/addon-interactions": "^8.6.0",
    "@storybook/react": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@storybook/test": "^8.6.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.21",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "autoprefixer": "^10.7.0",
    "chromatic": "^18.15.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
