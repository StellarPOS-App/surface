# ─── StellarPOS Surface — environment variables ───────────────────────────────
#
# Copy this file to .env.local and fill in the values for your environment.
# Variables prefixed with VITE_ are bundled into the client build by Vite and
# are visible in the browser. Do not put secrets in VITE_ variables.
#
# .env.local is git-ignored. Never commit real credentials.

# ─── API ───────────────────────────────────────────────────────────────────────

# Base URL for all backend API calls.
# Leave as /api/v1 during local development — the Vite dev server proxies it
# to VITE_DEV_API_TARGET (see below). Set to an absolute URL (e.g.
# https://api.example.com/api/v1) in production / Netlify env vars.
VITE_API_BASE_URL=/api/v1

# ─── WebSocket ─────────────────────────────────────────────────────────────────

# Socket.IO server origin.
# Leave empty during local development — the dev proxy handles /socket.io on
# the same origin. In production set to the backend origin, e.g.
# https://api.example.com
VITE_SOCKET_URL=

# ─── Session ───────────────────────────────────────────────────────────────────

# Idle timeout in minutes before an unattended till is automatically signed out.
# A warning is shown 5 minutes before the timeout fires.
# Default: 30 minutes. Set to 0 to disable.
VITE_IDLE_TIMEOUT_MINUTES=30

# ─── Turrets Escrow (optional — FEAT-022) ─────────────────────────────────────
#
# Leave all of these unset to disable escrow mode entirely (the default).
# See docs/turrets-escrow.md for setup instructions.

# Minimum single-transaction amount in XLM that triggers Turrets escrow.
# Transactions below this threshold use the normal Stellar QR checkout.
VITE_ESCROW_THRESHOLD_XLM=500

# Base URL of your Stellar Turret, e.g. https://turret.example.com
# Leave empty to disable escrow mode regardless of VITE_ESCROW_THRESHOLD_XLM.
VITE_TURRET_ENDPOINT=

# Merchant's Stellar public key (G…) used as one escrow co-signer.
# This is the public key only — the backend holds the signing secret.
VITE_ESCROW_MERCHANT_KEY=

# Hours before an unsigned escrow deposit is automatically refunded.
# Set to 0 during testnet development to trigger an immediate auto-refund.
VITE_ESCROW_DISPUTE_WINDOW_HOURS=48

# ─── Development only ──────────────────────────────────────────────────────────

# Target URL that `npm run dev` proxies /api/* and /socket.io/* to.
# Ignored in production builds.
VITE_DEV_API_TARGET=http://localhost:3000
